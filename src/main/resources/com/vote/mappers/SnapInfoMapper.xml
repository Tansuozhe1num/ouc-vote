<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vote.mappers.SnapInfoMapper">
    <resultMap id="snapMap" type="com.vote.data.po.SnapInfo">
        <id column="snap_id" property="snapId"/><result column="user_id" property="userId"/>
        <result column="snap_image" property="snapImage"/><result column="status" property="status"/>
        <result column="desc" property="desc"/><result column="type" property="type"/><result column="ctime" property="ctime"/>
        <result column="user_name" property="userName"/><result column="user_description" property="userDescription"/>
        <result column="major" property="major"/><result column="sex" property="sex"/>
    </resultMap>
    <sql id="columns">s.snap_id,s.user_id,s.snap_image,s.status,s.`desc`,s.type,s.ctime,u.name user_name,u.description user_description,u.major,u.sex</sql>
    <sql id="joins">FROM snap s JOIN `user` u ON u.user_id=s.user_id</sql>
    <select id="selectSnapInfoList" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/>
        WHERE s.status=0 AND u.status=0 ORDER BY s.snap_id DESC LIMIT #{offset},#{limit}</select>
    <select id="selectSnapInfoListByType" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/>
        WHERE s.status=0 AND s.type=#{type} AND u.status=0 ORDER BY s.snap_id DESC LIMIT #{offset},#{limit}</select>
    <select id="selectBySnapId" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/>
        WHERE s.snap_id=#{snapId} AND s.status=0 AND u.status=0</select>
    <select id="selectByUserId" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/>
        WHERE s.user_id=#{userId} AND s.status=0 ORDER BY s.snap_id DESC LIMIT 1</select>
    <select id="selectMine" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/>
        WHERE s.user_id=#{userId} AND s.status IN (0,1,2) ORDER BY s.snap_id DESC LIMIT #{offset},#{limit}</select>
    <select id="selectByIds" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/>
        WHERE s.snap_id IN <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
        AND s.status=0 AND u.status=0 ORDER BY FIELD(s.snap_id,<foreach collection="ids" item="id" separator=",">#{id}</foreach>)</select>
    <select id="selectMaxSnapId" resultType="java.lang.Integer">SELECT COALESCE(MAX(snap_id),0) FROM snap</select>
    <update id="updateStatus">UPDATE snap SET status=#{status} WHERE snap_id=#{snapId} AND user_id=#{userId}</update>
    <select id="selectList" resultMap="snapMap">SELECT <include refid="columns"/> <include refid="joins"/> WHERE s.status=0 ORDER BY s.snap_id DESC</select>
    <insert id="insert" parameterType="com.vote.data.po.SnapInfo" useGeneratedKeys="true" keyProperty="bean.snapId" keyColumn="snap_id">
        INSERT INTO snap(user_id,snap_image,status,`desc`,type,ctime)
        VALUES(#{bean.userId},#{bean.snapImage},#{bean.status},#{bean.desc},#{bean.type},#{bean.ctime})
    </insert>
</mapper>
